{
  "_comment": "Fast pipeline check for the locality sweep: same shape as study_test_2.json (stride and scatter distance swept against a max page size ladder) but cut down to 100 events and three page sizes so a full run finishes in minutes. 262144 particles/event puts exactly 1 MiB of each column in an event, so the number of events sharing a page tracks the page size in MiB. Too coarse to draw conclusions from, enough to prove the configs, the CSV columns and the plots line up.",
  "output_roots": {
    "generation": "output/generation/study",
    "writing": "output/writing/study"
  },
  "defaults": {
    "generation": {
      "seed": 42,
      "position": {
        "distribution": "uniform",
        "x": { "min": -150.0, "max": 150.0 },
        "y": { "min": -75.0, "max": 75.0 },
        "z": { "min": -500.0, "max": 500.0 }
      },
      "momentum": { "mean": 0.0, "stddev": 1.0, "min_magnitude": 0.05 }
    }
  },
  "tiers": {
    "smoke": {
      "generation": {
        "num_events": [500],
        "particles": [{ "min": 262144, "max": 524288 }]
      },
      "writing": {
        "variants": ["no-shuffle"],
        "max_page_size_mib": [1, 2, 4, 6, 8, 10]
      },
      "reading": {
        "access_pattern": ["sequential", "random", "strided", "scatter"],
        "stride": [2, 4, 8, 10, 12],
        "scatter_distance": [2, 4, 8, 16, 32],
        "products": ["momentum"],
        "scatter_seed": 1234,
        "access_seed": 1234,
        "cache": ["cold"],
        "cluster_cache": ["off"],
        "implicit_mt": ["off"],
        "num_events": 500,
        "repetitions": 2
      }
    }
  }
}
