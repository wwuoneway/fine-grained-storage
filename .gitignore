*.swp

# Documentation for internal development, not needed in the repository
docs.me/

# =========================
# Generated benchmark data
# =========================
# Phase 1 writes all synthetic input data under output/ (configurable via the
# "output_dir" config key). It is generated at runtime and must never be
# committed.
output/

.env

# Local AI-agent / editor tooling; never commit.
.claude/
.agents/
.codex/

# Study configs are regenerated from configs/study/axes.json by
# scripts/gen_study_configs.py on each run; only the axes files are tracked.
configs/generation/study/
configs/writing/study/
configs/benchmarks/study/
configs/generation/auto-generated/
configs/writing/auto-generated/
configs/benchmarks/auto-generated/

# CMake build trees (also covered by build/ above, listed here for clarity).
build/