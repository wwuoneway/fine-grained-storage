# Copy to .env and set for your machine. Used by scripts/run_study_all.sh.

FGS_SPACK_SETUP="/path/to/spack/share/spack/setup-env.sh"
FGS_SPACK_ENV="your-root-env"

# Optional: CPUs for the read benchmark, taskset -c syntax. Unset = no pinning.
# Use both siblings of one core: cat /sys/devices/system/cpu/cpu4/topology/thread_siblings_list
#FGS_BENCH_CPUS="4,5"
