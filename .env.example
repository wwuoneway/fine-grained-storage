# Copy to .env and set for your machine. Used by scripts/run_study_all.sh.

FGS_SPACK_SETUP="/path/to/spack/share/spack/setup-env.sh"
FGS_SPACK_ENV="your-root-env"

# Optional: CPUs for the read benchmark, taskset -c syntax. Unset = no pinning.
# Pick one CPU per physical core, never two siblings: they share execution units
# and caches, so the reader and the cluster-cache I/O thread would contend.
#   cat /sys/devices/system/cpu/cpu*/topology/thread_siblings_list | sort -u
#FGS_BENCH_CPUS="4,6"
